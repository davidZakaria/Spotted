# --- Core ---
DATABASE_URL=postgresql://spotted:spotted@spotted-db:5432/spotted
REDIS_URL=redis://spotted-redis:6379
APP_URL=http://localhost:4721
NEXT_PUBLIC_APP_URL=http://localhost:4721
AUTH_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# 32-byte key, base64. Required in production to encrypt OAuth and Page tokens at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Demo workspace. Off unless set. Never enable in production.
SEED_DEMO=false

# closed | invite | open. Unset = closed once an owner exists, otherwise open for first install.
SIGNUP_MODE=

# Session cookie lifetime in days (HttpOnly, SameSite=Lax, Secure in production).
SESSION_DAYS=7
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# One-time owner CLI: npm run auth:create-owner
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_NAME=Owner
# OWNER_WORKSPACE=Spotted
# FORCE_OWNER=false

# Seeded demo login (only if SEED_DEMO=true): demo@spotted.app / demo1234

# --- Sentiment (optional LLM; local EN+AR lexicon always available) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# --- Email / Slack alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Spotted <alerts@localhost>
SLACK_WEBHOOK_URL=

# --- Web search (provider-agnostic) ---
# Google Custom Search JSON API is closed to new customers and shuts down 1 Jan 2027.
# Default: Brave Search. Alternative: SerpAPI.
WEB_SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
# Free plan is 250/month. Live Search uses this; each watched word gets 2 scheduled refreshes/day.
SERPAPI_MONTHLY_LIMIT=250

# --- Apify scraper (Scraper tab). Never stores site cookies or logins. ---
APIFY_TOKEN=
# Optional monthly spend cap in USD (workspace setting can override).
APIFY_MONTHLY_LIMIT_USD=25

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- X (Twitter) API v2 — pay-per-use; enforced via workspace budgets ---
TWITTER_BEARER_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Meta: Facebook + Instagram + Threads + Messenger ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_PAGE_ACCESS_TOKEN=
THREADS_APP_ID=
THREADS_APP_SECRET=
# Optional extra Facebook Login scopes, e.g. instagram_basic,instagram_manage_comments
META_EXTRA_SCOPES=

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Google Business Profile + Trends ---
GOOGLE_GBP_CLIENT_ID=
GOOGLE_GBP_CLIENT_SECRET=
GOOGLE_TRENDS_ENABLED=true

# --- Reddit ---
# Default listening uses SerpAPI: site:reddit.com <keyword> (same monthly budget).
# Commercial use of Reddit's own API needs written approval (Responsible Builder Policy).
# Set these only after approval — there is no public JSON fallback.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Must look like: platform:app-id:version (by /u/your_reddit_username)
REDDIT_USER_AGENT=

# --- Bluesky publishing ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Mastodon ---
MASTODON_INSTANCE=https://mastodon.social
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# --- Pinterest ---
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Twitch ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Podcast Index (iTunes Search is the keyless fallback) ---
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# --- Reviews ---
TRUSTPILOT_API_KEY=
G2_API_TOKEN=
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
APPSTORE_PRIVATE_KEY=
GOOGLE_PLAY_JSON=

# --- Snapchat publishing ---
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=
